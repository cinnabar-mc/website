<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Explore a browser demo of free community mods for Cinnabar.">
  <title>Marketplace · Cinnabar</title>
  <link rel="icon" type="image/svg+xml" href="@@FAVICON@@">
  <style>:root { --red: @@RED@@; }</style>
  <link rel="stylesheet" href="/marketplace/marketplace.css">
  <script src="/marketplace/marketplace-model.js" defer></script>
  <script src="/marketplace/marketplace.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to marketplace</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Cinnabar home"><img src="@@FAVICON@@" width="28" height="28" alt="">Cinnabar</a>
    <nav aria-label="Website"><a href="/">Get the client</a><a href="/marketplace/" aria-current="page">Marketplace</a></nav>
    <button type="button" class="subtle" id="signin-link">Microsoft sign-in setup</button>
  </header>
  <main id="main" class="shell">
    <aside class="demo-notice" aria-label="Demo limitations">
      <strong>Browser demo</strong><span>Synthetic sample catalog. Changes stay on this device. No downloads or real accounts.</span>
      <button type="button" id="demo-toggle" aria-expanded="false" aria-controls="demo-controls">Try another role</button>
    </aside>
    <section id="demo-controls" class="demo-controls" hidden aria-label="Local role simulation">
      <div><h2>Try a local demo role</h2><p>This switch simulates workflows. It does not sign you in or grant access to Cinnabar.</p></div>
      <label>Demo role<select id="demo-role"></select></label>
      <button type="button" class="subtle" id="reset-demo">Reset demo data</button>
    </section>
    <div class="page-heading"><div><h1>Marketplace</h1><p>Small additions. More ways to make it yours.</p></div><span class="role-indicator" id="role-indicator">Local demo · Player</span></div>
    <nav class="workspace-nav" aria-label="Marketplace sections" id="workspace-nav"></nav>
    <p id="feedback" role="status" aria-live="polite" aria-atomic="true"></p>
    <div id="workspace"><div class="loading" role="status">Loading the sample catalog…</div></div>
    <noscript><p class="notice">Enable JavaScript to explore this browser demo. Microsoft sign-in, downloads, and publishing are not connected.</p></noscript>
    <footer><span>Cinnabar community mods</span><span>Free community mod proof of concept</span></footer>
  </main>
</body>
</html>
